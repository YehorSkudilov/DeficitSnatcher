# Every setting. Copy to .env (git-ignored) next to docker-compose.yml: compose passes it to the API container, and the
# API loads it itself when run with dotnet run from DeficitSnatcher.Api (copy it there too, or symlink).
# On the server the Deploy workflow writes it from the repository's GitHub secrets and variables.
# "__" separates sections (Auth__Username = Auth:Username). Everything else (price ranges, sites, intervals,
# notifications, auto-buy) is set on the site and kept in the database.

# ---- Sign-in: the one account. There are no sign-ups; change these to change the login. ----
Auth__Username=owner
Auth__Password=
Auth__TokenDays=14

# JWT signing key, at least 32 characters (openssl rand -base64 48). Changing it signs you out.
Jwt__SigningKey=

# Encrypts the card, the settings, cookies, checkout screenshots and page HTML in the database: 32 random bytes,
# base64 (openssl rand -base64 32). Never change or lose it once set. Empty: derived from the JWT key.
Secrets__Key=

# ---- Database ----
POSTGRES_USER=deficitsnatcher
POSTGRES_PASSWORD=deficitsnatcher_dev
POSTGRES_DB=deficitsnatcher
# For dotnet run outside Docker (docker compose up -d db first); the container sets its own.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=deficitsnatcher;Username=deficitsnatcher;Password=deficitsnatcher_dev

# ---- The site ----
# Its public address, for links in notifications (e.g. https://snatcher.example.com). Optional.
App__PublicUrl=
# Host port of the site (the reverse proxy forwards to it).
WEB_PORT=8090
# Development only (docker-compose.dev.yml): the database on localhost.
DB_PORT=5432
# Only for npm run dev against a separately run API (in Docker it's one origin).
Cors__AllowedOrigins=http://localhost:3000

# ---- Deploy tab: runs the Deploy workflow on GitHub. Leave the token empty to turn it off. ----
# A fine-grained token for this repository with Actions (read and write) and Contents (read).
Deploy__GitHubToken=
Deploy__Repository=YehorSkudilov/DeficitSnatcher
Deploy__Workflow=Deploy.yml
Deploy__Branch=main

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
RateLimiting__AuthPerMinute=5
