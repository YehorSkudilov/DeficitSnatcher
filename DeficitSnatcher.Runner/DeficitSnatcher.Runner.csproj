<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window of its own on Windows (the background helper has none); it borrows the terminal, or opens one. -->
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
  </ItemGroup>

</Project>
