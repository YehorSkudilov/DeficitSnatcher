# All settings of the API. Copy to .env (git-ignored) next to this file: docker-compose.yml passes it to the container,
# and the API loads it itself when run with dotnet run. On the server the Publish API workflow writes it from the
# repository's GitHub variables and secrets. "__" separates sections (Auth__Username = Auth:Username).
# Everything else (intervals, price ranges, notifications, auto-buy) is set on the web and kept in the database.

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning

# Database. docker-compose.yml creates it from the POSTGRES_* values; the connection string is for dotnet run.
POSTGRES_USER=deficitsnatcher
POSTGRES_PASSWORD=deficitsnatcher_dev
POSTGRES_DB=deficitsnatcher
ConnectionStrings__Default=Host=localhost;Port=5432;Database=deficitsnatcher;Username=deficitsnatcher;Password=deficitsnatcher_dev
# Apply pending migrations at startup (always on in Development)
Database__MigrateOnStartup=false

# The one account that signs in to the web.
Auth__Username=owner
Auth__Password=
Auth__TokenDays=14

# JWT signing key, at least 32 characters (openssl rand -base64 48).
Jwt__SigningKey=

# Encrypts the checkout profile (card), settings and cookies in the database: 32 random bytes, base64
# (openssl rand -base64 32). Never change or lose it once set. Empty: derived from the JWT key.
Secrets__Key=

# The web's address (DeficitSnatcher.Web), comma-separated if several.
Cors__AllowedOrigins=http://localhost:3000

RateLimiting__AuthPerMinute=10

# Host ports (docker-compose.yml)
API_PORT=8090
DB_PORT=5432
